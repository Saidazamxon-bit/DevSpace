# DEVSPACE configuration. Copy to .env (the web installer does this for you).
# NEVER commit .env — it contains your database password and encryption key.

APP_NAME=DEVSPACE
APP_ENV=production
APP_DEBUG=false
APP_URL=https://devspace.example.com
APP_TIMEZONE=Asia/Tashkent
# 32-byte key used to encrypt API Vault secrets. Generate with: php bin/console.php key:generate
# Losing or changing this key makes stored secrets unreadable — back it up somewhere safe.
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=devspace
DB_USERNAME=devspace
DB_PASSWORD=

# auto = secure cookies when the request is HTTPS
SESSION_SECURE=auto
# idle timeout in minutes
SESSION_LIFETIME=480

# Sender address for downtime / expiry alert emails (leave empty to disable email)
MAIL_FROM=

# Create a database backup every night from cron/daily.php
BACKUP_DAILY=false
MONITOR_RETENTION_DAYS=90
